# Copy to .env and fill. Never commit .env.

# Where a run renders and where its results go.
#   local   (default) renders with harness/render.js and writes to experiments/.
#           Touches no sandbox and no Convex, so iterating cannot take the live
#           site down or hijack its front page.
#   convex  sandboxes plus Convex. What the deployed service uses.
RUN_MODE=local

# Model provider. claude-cli or xai. Both implement orchestrator/llm.ts.
#   claude-cli  local default: shells out to the Claude Code CLI, billed to the
#               subscription rather than the API budget. Cannot authenticate on
#               Render, so it is for the laptop and the recorded demo.
#   xai         what the deployed orchestrator uses, and the partner path.
LLM_PROVIDER=claude-cli

# claude-cli path. No key: the CLI uses the logged-in session.
CLAUDE_BINARY=claude
CLAUDE_CLI_MODEL=claude-opus-5
# low, medium, high, xhigh, max. Codegen latency is thinking time, not output
# volume: the same six-candidate call measures 226s at the session default and
# 83s at medium, which is 11 minutes a run against 4. Not low, where the model
# stops animating and the prefilter zeroes five of six. Empty uses the default.
CLAUDE_CLI_EFFORT=medium

# x.ai. OpenAI compatible, baseURL https://api.x.ai/v1
# Console API key, not Grok Bot. Read the vision capable model id off the console
# rather than guessing: ids change and a stale one fails at the worst time.
XAI_API_KEY=
XAI_MODEL=

# Daytona sandboxes.
DAYTONA_API_KEY=
# Snapshot built from harness/Dockerfile with Playwright and Chromium preinstalled.
# Name is recorded in harness/README.md when the snapshot exists.
DAYTONA_SNAPSHOT=

# Convex deployment the orchestrator writes to, via the HTTP client.
CONVEX_URL=

# Fal.ai. Reference mode only, one call per run.
FAL_KEY=

# Orchestrator HTTP server.
ORCHESTRATOR_PORT=8787

# VITE_ prefixed variables are the only ones Vite exposes to browser code.
VITE_CONVEX_URL=
# Where the browser POSTs /run. The orchestrator must send permissive CORS headers
# or this fails in the browser while working from curl.
VITE_ORCHESTRATOR_URL=
