# Copy to .env and fill. Never commit .env.

# x.ai, OpenAI compatible chat completions.
# Console API key, not Grok Bot. baseURL https://api.x.ai/v1
XAI_API_KEY=
# Vision capable model id, read from the x.ai console. Do not hardcode a guess:
# ids change and a stale one fails at the worst time.
XAI_MODEL=

# Daytona sandboxes.
DAYTONA_API_KEY=
# Snapshot built from harness/Dockerfile with Playwright and Chromium preinstalled.
# Name is recorded in harness/README.md when the snapshot exists.
DAYTONA_SNAPSHOT=

# Convex deployment the orchestrator writes to, via the HTTP client.
CONVEX_URL=

# Fal.ai. Reference mode only, one call per run.
FAL_KEY=

# Orchestrator HTTP server.
ORCHESTRATOR_PORT=8787

# VITE_ prefixed variables are the only ones Vite exposes to browser code.
VITE_CONVEX_URL=
# Where the browser POSTs /run. The orchestrator must send permissive CORS headers
# or this fails in the browser while working from curl.
VITE_ORCHESTRATOR_URL=
