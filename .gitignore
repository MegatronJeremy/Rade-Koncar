# Secrets. .env.example is tracked and carries the variable list.
.env
.env.*
!.env.example

# Dependencies and build output, per folder.
node_modules/
dist/
build/
*.tsbuildinfo

# Local iterations. Throwaway by design: they exist so a run can be judged
# before anyone decides to keep it. experiments/samples-backup is deliberate and
# stays tracked.
experiments/local-*/

# Harness render output. `node render.js --out out/` writes here.
# Committed frames live in harness/fixtures/ and are not covered by this.
out/

# tsc output. The Dockerfile builds these.
harness/render.js
harness/snapshot.js
harness/verify-sandbox.js
harness/batch.js

# Playwright.
playwright-report/
test-results/
.playwright/

# Logs.
*.log
npm-debug.log*

# OS and editor.
.DS_Store
.idea/
.vscode/

# Agent tooling scratch.
.playwright-mcp/

# Left behind by `daytona snapshot create` on Windows.
context.tar

# Absolute local paths, per-machine.
.claude/launch.json
.claude/settings.local.json
